# Copy to .env.local for local development. Never commit values.
# docs/architecture.md and docs/deployment.md explain each variable.

DATABASE_URL=
TEST_DATABASE_URL=
APP_SIGNING_SECRET=
APP_ORIGIN=
MCP_ALLOWED_ORIGINS=

# PayPal sandbox credentials, one set per shops.paypal_credential_ref value.
PAYPAL_CLIENT_ID_DEMO_PHONE_WORKSHOP=
PAYPAL_CLIENT_SECRET_DEMO_PHONE_WORKSHOP=
PAYPAL_WEBHOOK_ID_DEMO_PHONE_WORKSHOP=
# The second demo shop (candle studio), a different seller app and account
PAYPAL_CLIENT_ID_DEMO_SECOND_SHOP=
PAYPAL_CLIENT_SECRET_DEMO_SECOND_SHOP=
PAYPAL_WEBHOOK_ID_DEMO_SECOND_SHOP=

# Reads price list photos and suggests descriptions and search terms. CSV import and search work without it.
ANTHROPIC_API_KEY=

# Partner configuration, used once each integration lands. docs/integrations.md explains each
# one. Use the Bryntum key only on its Business track.
AG_STUDIO=
OPENAI_API_KEY=
NEXT_PUBLIC_BRYNTUM_LICENSE_KEY=
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=
RENDER_USE_LOCAL_DEV=
RENDER_LOCAL_DEV_URL=

# Optional, read by `npm run db:seed`.
DEMO_PHONE_WORKSHOP_PAYPAL_MERCHANT_ID=
DEMO_PHONE_WORKSHOP_SELLER_CODE=
DEMO_SECOND_SHOP_PAYPAL_MERCHANT_ID=
DEMO_SECOND_SHOP_SELLER_CODE=
# The demo's "today" as YYYY-MM-DD in Riga. Empty means today. Read by db:seed and demo:reset.
DEMO_DATE=
# Must be "true" before demo:reset will run. Set it only on a demo or sandbox service.
DEMO_ENVIRONMENT=
