# Copy to .env.local for local development, keep real credentials out of Git and chat

# Core application
DATABASE_URL=
# Required only for the full npm test suite; use a disposable test database
TEST_DATABASE_URL=
APP_SIGNING_SECRET=
# Safe local origin, Render falls back to RENDER_EXTERNAL_URL when this is blank
APP_ORIGIN=http://localhost:3000
# Optional extra browser origins for MCP
MCP_ALLOWED_ORIGINS=

# Primary PayPal path: one Sandbox Platform REST app for seller consent and payments
PAYPAL_PLATFORM_CLIENT_ID=
PAYPAL_PLATFORM_CLIENT_SECRET=
PAYPAL_PLATFORM_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
# Separate webhook subscriptions on that same Platform app
PAYPAL_PLATFORM_WEBHOOK_ID=
PAYPAL_PLATFORM_PAYMENT_WEBHOOK_ID=

# Optional PayPal Sandbox Login, configured in its own names even when reusing the Platform app
# Reuse the Platform app's ID and secret here only if Log in with PayPal is enabled on that app
PAYPAL_LOGIN_CLIENT_ID=
PAYPAL_LOGIN_CLIENT_SECRET=

# Optional AI and partner integrations
# AI provider: openai or anthropic, its API root (https, blank for the provider's default) and its key
AGENT_SHELF_AI_PROVIDER=
AGENT_SHELF_AI_PROVIDER_BASE_URL=
AGENT_SHELF_AI_PROVIDER_API_KEY=
# Older Claude-only setting, read only while AGENT_SHELF_AI_PROVIDER is blank
ANTHROPIC_API_KEY=
# Locally, the seller dashboard reads AG_STUDIO. The deployment workflow maps the GitHub secret
# AGENT_SHELF_AG_STUDIO_LICENCE to this same Render runtime variable.
AG_STUDIO=
# Render Workflows, optional when imports run inside the web service
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=
# Local Render Workflows development only
RENDER_USE_LOCAL_DEV=
RENDER_LOCAL_DEV_URL=

# Optional legacy direct-merchant Sandbox apps for demo checkout and paypal:proof diagnostics
# These are not required for the Platform app seller-consent path
PAYPAL_CLIENT_ID_DEMO_PHONE_WORKSHOP=
PAYPAL_CLIENT_SECRET_DEMO_PHONE_WORKSHOP=
PAYPAL_WEBHOOK_ID_DEMO_PHONE_WORKSHOP=
PAYPAL_CLIENT_ID_DEMO_SECOND_SHOP=
PAYPAL_CLIENT_SECRET_DEMO_SECOND_SHOP=
PAYPAL_WEBHOOK_ID_DEMO_SECOND_SHOP=

# Optional values applied by db:seed to the two demo shops
DEMO_PHONE_WORKSHOP_PAYPAL_MERCHANT_ID=
DEMO_PHONE_WORKSHOP_SELLER_CODE=
DEMO_SECOND_SHOP_PAYPAL_MERCHANT_ID=
DEMO_SECOND_SHOP_SELLER_CODE=
# The demo's "today" as YYYY-MM-DD in Riga, blank means today
DEMO_DATE=
# Required as exactly "true" before demo:reset will run
DEMO_ENVIRONMENT=
